<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SaveVault.Core/SaveVault.Core.csproj" />
    <!-- Exercise production view-model state on Linux without loading WPF or Windows services. -->
    <Compile Include="../../src/SaveVault.App/Infrastructure/*.cs" Link="App/Infrastructure/%(Filename)%(Extension)" />
    <Compile Include="../../src/SaveVault.App/ViewModels/*.cs" Link="App/ViewModels/%(Filename)%(Extension)" />
    <Compile Include="../../src/SaveVault.App/Services/IUserDialogs.cs" Link="App/Services/IUserDialogs.cs" />
    <Compile Include="../../src/SaveVault.App/Services/ActivityLog.cs" Link="App/Services/ActivityLog.cs" />
  </ItemGroup>
</Project>
