<Window x:Class="SaveVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SaveVault — Backup &amp; Restore" Width="1200" Height="820"
        MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded" Closing="OnClosing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#17243B" Padding="20,28">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="SaveVault" Foreground="White" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Your files. Your history." Foreground="#A9BAD4" Margin="0,6,0,28" />
                    <Button Content="+  New profile" Command="{Binding NewProfileCommand}" Margin="0,0,0,22" />
                    <TextBlock Text="BACKUP PROFILES" Foreground="#A9BAD4" FontSize="11" FontWeight="Bold" Margin="0,0,0,12" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                    <TextBlock Text="LOCAL-FIRST · SAVE DISCOVERY" Foreground="#A9BAD4" FontSize="10" />
                    <TextBlock Text="Folders · Game saves · Music" Foreground="#DDE7F7" FontSize="12" Margin="0,8,0,10" />
                    <Button Content="Open log folder" Command="{Binding OpenLogsCommand}" Margin="0" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                         IsEnabled="{Binding IsIdle}" Background="Transparent" BorderThickness="0"
                         Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,12" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Kind}" FontSize="11" Margin="0,5,0,0" Opacity="0.8" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Protect what matters" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Versioned backups, verified content, and controlled restores." Style="{StaticResource Hint}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Back up saved profile" Command="{Binding BackupCommand}"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>

            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0" Padding="0,16,0,0">
                <TabItem Header="  Profile  ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource Card}">
                            <StackPanel IsEnabled="{Binding IsIdle}">
                                <TextBlock Text="What would you like to protect?" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Add any folder, including a game's save directory. Save your changes before running a backup." Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Profile name" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Category" Style="{StaticResource Label}" />
                                        <ComboBox ItemsSource="{Binding ProfileKinds}" SelectedItem="{Binding Kind}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Source folders" Style="{StaticResource Label}" />
                                <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" MinHeight="100" MaxHeight="160"
                                         BorderBrush="#D8DFEB" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate><StackPanel Margin="5,6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Path}" Style="{StaticResource Hint}" FontSize="12" /><TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Hint}" FontSize="12" /></StackPanel></DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Add folder" Command="{Binding AddSourceCommand}" />
                                    <Button Content="Add file" Command="{Binding AddFileCommand}" />
                                    <Button Content="Remove selected" Command="{Binding RemoveSourceCommand}" />
                                </StackPanel>
                                <TextBlock Text="Backup destination" Style="{StaticResource Label}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseDestinationCommand}" Margin="8,0,0,0" />
                                    <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <TextBlock Text="Choose a separate folder on a local drive, external drive, or network share." Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,0" />
                                <TextBlock Text="Exclude patterns (one per line)" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding Exclusions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" />
                                <TextBlock Text="Examples: *.tmp, cache, shadercache. A matching folder excludes its contents." Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                    <Button Content="Save profile" Command="{Binding SaveProfileCommand}" Style="{StaticResource PrimaryButton}" />
                                    <Button Content="Remove profile" Command="{Binding DeleteProfileCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="  History &amp; restore  ">
                    <Grid IsEnabled="{Binding IsIdle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="150" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Open repository…" Command="{Binding OpenRepositoryCommand}" />
                                <Button Content="Refresh" Command="{Binding RefreshHistoryCommand}" />
                                <Button Content="Verify snapshot" Command="{Binding VerifyCommand}" Margin="0" />
                            </StackPanel>
                            <StackPanel><TextBlock Text="Backup history" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding HistorySummary}" Style="{StaticResource Hint}" Margin="0,4,0,0" /></StackPanel>
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#D8DFEB">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Created (UTC)" Binding="{Binding CreatedUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="180" />
                                <DataGridTextColumn Header="Profile" Binding="{Binding ProfileName}" Width="130" />
                                <DataGridTextColumn Header="Files" Binding="{Binding Files.Count}" Width="70" />
                                <DataGridTextColumn Header="Total bytes" Binding="{Binding TotalBytes, StringFormat=N0}" Width="120" />
                                <DataGridTextColumn Header="Skipped links" Binding="{Binding SkippedLinks.Count}" Width="100" />
                                <DataGridTextColumn Header="Snapshot ID" Binding="{Binding Id}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Grid.Row="2" Margin="0,16,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Select all" Command="{Binding SelectAllCommand}" />
                                <Button Content="Select none" Command="{Binding SelectNoneCommand}" Margin="0" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" Style="{StaticResource Hint}" />
                        </DockPanel>
                        <DataGrid Grid.Row="3" ItemsSource="{Binding Files}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#D8DFEB">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Restore" Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Source" Binding="{Binding SourceName}" IsReadOnly="True" Width="140" />
                                <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" IsReadOnly="True" Width="*" />
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" IsReadOnly="True" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Restore to another folder" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseRestoreCommand}" Margin="8,0,0,0" />
                                    <TextBox Text="{Binding RestoreDestination, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <TextBlock Text="Files are grouped by source folder. Original source folders remain separate." Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,8" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Preview restore…" Command="{Binding RestoreCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                                    <CheckBox Content="Overwrite conflicts and preserve previous files in a rollback folder"
                                              IsChecked="{Binding OverwriteConflicts}" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="  Games  ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding Games}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Find your game saves" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Catalog rules, alternate locations, and observed changes. Review each candidate before creating a backup profile." Style="{StaticResource Hint}" Margin="0,6,0,12" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Update full catalog" Command="{Binding UpdateCatalogCommand}" />
                                        <TextBlock Text="{Binding CatalogStatus}" Style="{StaticResource Hint}" VerticalAlignment="Center" FontSize="12" />
                                    </DockPanel>
                                    <StackPanel IsEnabled="{Binding InputsEnabled}">
                                        <TextBlock Text="Game-library folders (one per line)" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding LibraryFolders, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="55" VerticalScrollBarVisibility="Auto" />
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Add library folder…" Command="{Binding BrowseLibraryCommand}" />
                                            <Button Content="Discover games" Command="{Binding DiscoverCommand}" Style="{StaticResource PrimaryButton}" />
                                            <Button Content="Add game folder…" Command="{Binding AddGameCommand}" />
                                            <Button Content="Select executable…" Command="{Binding AddExecutableCommand}" />
                                        </WrapPanel>
                                        <TextBlock Text="Game installation" Style="{StaticResource Label}" />
                                        <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" DisplayMemberPath="Title" />
                                        <TextBlock Text="{Binding SelectedGame.Path}" Style="{StaticResource Hint}" FontSize="12" Margin="0,5,0,0" />
                                        <TextBlock Text="Search catalog title (aliases supported)" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding CatalogSearch, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox ItemsSource="{Binding CatalogMatches}" SelectedItem="{Binding SelectedCatalogGame}" DisplayMemberPath="Title" Margin="0,6,0,0" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Content="Find save locations" Command="{Binding FindSavesCommand}" Style="{StaticResource PrimaryButton}" />
                                            <Button Content="Search more locations" Command="{Binding SearchMoreCommand}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Find my saves while I play" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock Text="Watch/search folders (one per line). The game installation is added automatically. Narrow these folders if a scan reaches its limits." Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,8" />
                                    <TextBox Text="{Binding WatchFolders, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding InputsEnabled}" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="Add watch folder…" Command="{Binding AddWatchFolderCommand}" />
                                        <Button Content="Start watching" Command="{Binding StartWatchCommand}" />
                                        <Button Content="Finish &amp; review changes" Command="{Binding FinishWatchCommand}" Style="{StaticResource PrimaryButton}" />
                                        <Button Content="Discard watch" Command="{Binding DiscardWatchCommand}" />
                                    </WrapPanel>
                                    <TextBlock Text="Start watching, launch the game yourself, make a manual save, exit it, then finish. Observed changes do not identify the writing process." Style="{StaticResource Hint}" FontSize="12" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <DataGrid ItemsSource="{Binding Candidates}" AutoGenerateColumns="False" CanUserAddRows="False"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Height="250" IsEnabled="{Binding InputsEnabled}">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Use" Width="45">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" IsReadOnly="True" Width="115" />
                                            <DataGridTextColumn Header="Folder" Binding="{Binding Root}" IsReadOnly="True" Width="230" />
                                            <DataGridTextColumn Header="Selection" Binding="{Binding Selection}" IsReadOnly="True" Width="140" />
                                            <DataGridTextColumn Header="Content" Binding="{Binding ContentKind}" IsReadOnly="True" Width="100" />
                                            <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" IsReadOnly="True" Width="50" />
                                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" IsReadOnly="True" Width="70" />
                                            <DataGridTextColumn Header="Modified (UTC)" Binding="{Binding LatestWriteUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" IsReadOnly="True" Width="155" />
                                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" IsReadOnly="True" Width="350" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Content="Create / update profile draft from selected" Command="{Binding UseSourcesCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                    <TextBlock Text="Existing confirmed sources are retained. Review the draft and save it in the Profile tab." Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,0" />
                                    <TextBox Text="{Binding Notices, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="  Activity  ">
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                                <TextBlock Text="Operation activity" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Recent events are shown here. Detailed daily logs are saved in your local app-data folder." Style="{StaticResource Hint}" Margin="0,8,0,0" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Activity}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,6" /></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="#E8EDF7" CornerRadius="8" Padding="14" Margin="0,18,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Cancel operation" Command="{Binding CancelCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentActivity}" Style="{StaticResource Hint}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                        <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="3" Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
