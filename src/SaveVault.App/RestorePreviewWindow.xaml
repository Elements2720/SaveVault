<Window x:Class="SaveVault.App.RestorePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview restore — SaveVault" Width="780" Height="550" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Review your restore" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Summary}" Margin="0,12,0,6" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Destination}" Style="{StaticResource Hint}" />
            <TextBlock Text="{Binding ConflictDescription}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding File.RelativePath}" Width="2*" />
                <DataGridCheckBoxColumn Header="Exists" Binding="{Binding AlreadyExists}" Width="60" />
                <DataGridTextColumn Header="Restore path" Binding="{Binding TargetPath}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Verify and restore" Click="OnRestore" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
